layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/download/v0.24.0/zjstatus.wasm" {
                format_left   "#[bg=#011423,fg=#47FF9C,bold] {session} #[bg=#011423]{tabs}"
                format_center ""
                format_right  ""
                format_space  "#[bg=#011423]"

                border_enabled             false
                hide_frame_for_single_pane true

                tab_normal "#[bg=#011423,fg=#214969] {name} "
                tab_active "#[bg=#033259,fg=#47FF9C,bold] ▶ {name} "
            }
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="💻 term" {
        pane name="shell"
    }
}
