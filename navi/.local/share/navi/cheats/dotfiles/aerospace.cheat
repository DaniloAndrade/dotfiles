% aerospace
# Hyper+H/J/K/L → foco (esquerda/baixo/cima/direita)
echo "Hyper+H/J/K/L → foco esquerda/baixo/cima/direita"

% aerospace
# Hyper+7/8/9/0/-/= → troca de workspace
echo "Hyper+7 DEV | Hyper+8 WEB | Hyper+9 COMM | Hyper+0 DOCS | Hyper+- PERSONAL | Hyper+= MONITORING"

% aerospace
# Hyper+Tab → volta pro workspace anterior
echo "Hyper+Tab → workspace-back-and-forth"

% aerospace
# Hyper+A → alterna layout tiles/accordion (empilhado)
echo "Hyper+A → toggle tiles/accordion"

% aerospace
# Hyper+W → entra no modo window (mover/trocar/mandar janela)
echo "Hyper+W → entra no modo window"

% aerospace
# [modo window] H/J/K/L → move a janela (toque, não segure)
echo "[window mode] H/J/K/L → move left/down/up/right"

% aerospace
# [modo window] Shift+H/J/K/L → troca de lugar com a vizinha (swap, wrap-around)
echo "[window mode] Shift+H/J/K/L → swap left/down/up/right"

% aerospace
# [modo window] 1..6 → manda a janela pro workspace
echo "[window mode] 1 DEV | 2 WEB | 3 COMM | 4 DOCS | 5 PERSONAL | 6 MONITORING"

% aerospace
# [modo window] Esc ou Enter → sai do modo, volta pro main
echo "[window mode] Esc/Enter → mode main"

% aerospace
# Hyper+R → entra no modo resize (ajustar largura/altura)
echo "Hyper+R → entra no modo resize"

% aerospace
# [modo resize] H/L → largura -50/+50, J/K → altura -50/+50
echo "[resize mode] H/L width -50/+50 | J/K height -50/+50 | Esc/Enter → mode main"

% aerospace
# Hyper+Space → entra no modo service (reset layout, floating, fechar outras, join-with)
echo "Hyper+Space → entra no modo service"

% aerospace
# [modo service] R reset layout | F toggle floating | Backspace fecha outras | H/J/K/L join-with
echo "[service mode] R reset | F floating toggle | Backspace close-others | H/J/K/L join-with | Esc → mode main"
