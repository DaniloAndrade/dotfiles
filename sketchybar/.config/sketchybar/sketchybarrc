#!/bin/bash

source "$HOME/.config/sketchybar/colors.sh"

sketchybar --bar position=top height=32 color="$COLOR_BG" topmost=window

for ws in DEV WEB COMM DOCS PERSONAL MONITORING; do
  sketchybar --add item "workspace_${ws}" left \
             --set "workspace_${ws}" \
                    label="$ws" \
                    label.color="$COLOR_FG" \
                    background.color="$COLOR_BG" \
                    background.drawing=on \
                    padding_left=6 \
                    padding_right=6 \
                    click_script="aerospace workspace ${ws}"
done

sketchybar --add item aerospace_mode left \
           --set aerospace_mode \
                  label="MAIN" \
                  label.color="$COLOR_FG" \
                  background.color="$COLOR_BG" \
                  background.drawing=on \
                  padding_left=8 \
                  padding_right=8

AEROSPACE_FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused) "$HOME/.config/sketchybar/plugins/aerospace_workspace.sh"
"$HOME/.config/sketchybar/plugins/aerospace_mode.sh"

sketchybar --update
